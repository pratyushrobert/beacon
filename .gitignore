# =========================================================================
# Beacon — Cybersecurity Network Traffic Investigation Platform
# Git Ignore Configuration
# =========================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
ENV*/

# --- Testing & Code Quality ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# --- Build & Distribution ---
# Release binaries are distributed via GitHub Releases; keep intermediates and outputs untracked
build/
dist/

# --- Secrets & Local Configuration ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
config.local.json

# --- Frontend & Tooling ---
node_modules/
web/node_modules/
web/dist/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs, Editors & OS Metadata ---
.vscode/
.idea/
.kilo/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs & Temporary Directories ---
logs/
*.log
tmp/
temp/
*.tmp
output/

# --- Local Databases & Transient Caches ---
cache/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# --- Captures & Packet Files ---
# Ignore raw network captures by default to prevent leaking private packet traffic
*.pcap
*.pcapng
*.cap
/test.pcap

# Explicitly track sanitized example fixtures required for tests & documentation
!examples/*.pcap
!examples/*.pcapng

# --- Reports ---
# Ignore generated incident exports while preserving report templates
reports/generated/
reports/*.pdf
reports/*.html
